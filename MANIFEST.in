# Include the license and readme
include LICENSE
include README.md
include pyproject.toml

# Include all documentation
recursive-include docs *.md

# Include packaged fixtures and test data
recursive-include aicomp_sdk/fixtures *.json *.txt *.md

# Include example files
recursive-include examples *.py *.md

# Include competition configuration
include competition.yaml

# Exclude compiled Python files
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.so
global-exclude .DS_Store

# Exclude version control
global-exclude .git*
global-exclude .hg*

# Exclude tests and research artifacts from distribution
prune fixtures
prune tests
prune research
prune scripts
